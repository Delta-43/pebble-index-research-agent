# Copy to docker/.env and fill in real values. Never commit the real .env file.

# --- MinIO / S3 remote used by Self-hosted LiveSync ---
LIVESYNC_S3_ENDPOINT=
LIVESYNC_S3_BUCKET=
LIVESYNC_S3_ACCESS_KEY=
LIVESYNC_S3_SECRET_KEY=
LIVESYNC_PASSPHRASE=

# --- LLM credential used by the n8n AI Agent node ---
# Configure this as an n8n credential instead where possible; listed here only if a service needs it directly.
LLM_API_KEY=

# --- SearXNG ---
SEARXNG_URL=http://searxng:8080

# --- Vault mirror host paths (livesync-cli, mcp-obsidian) ---
# Absolute host paths so multiple containers (and, later, n8n's own compose stack) can bind-mount the
# exact same directories. VAULT_MIRROR_DATA_PATH holds livesync-cli's local db + settings.json;
# VAULT_MIRROR_PATH is the actual plain-Markdown mirrored vault (needs a pre-existing empty
# `.obsidian/` subfolder — see docs/TROUBLESHOOTING.md).
VAULT_MIRROR_DATA_PATH=/data/vault-mirror/data
VAULT_MIRROR_PATH=/data/vault-mirror/vault

