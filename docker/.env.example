# Copy to docker/.env and fill in real values. Never commit the real .env file.

# --- MinIO / S3 remote used by Self-hosted LiveSync ---
LIVESYNC_S3_ENDPOINT=
LIVESYNC_S3_BUCKET=
LIVESYNC_S3_ACCESS_KEY=
LIVESYNC_S3_SECRET_KEY=
LIVESYNC_PASSPHRASE=

# --- LLM credential used by the n8n AI Agent node ---
# Configure this as an n8n credential instead where possible; listed here only if a service needs it directly.
LLM_API_KEY=

# --- SearXNG ---
SEARXNG_URL=http://searxng:8080

# --- Vault mirror host paths (livesync-cli, mcp-obsidian) ---
# Absolute host directories. livesync-cli writes plain .md files into VAULT_MIRROR_PATH; mcp-obsidian
# and (later) n8n's Local File Trigger read/write the same path. VAULT_MIRROR_DATA_PATH holds
# livesync-cli's own settings.json/state, separate from the vault content itself.
VAULT_MIRROR_DATA_PATH=
VAULT_MIRROR_PATH=
