    {
      "id": "7d1a6dbd-996e-4135-a662-de83a6b9e1fe",
      "name": "Pick Next Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A note needs research when it has no \"Researched:\" backlink, is not marked done,\n// and has failed fewer than MAX_ATTEMPTS times.\n// - File trigger, sweep and Watch Index Inbox (Manual): Index Inbox/ only, oldest first,\n//   up to MAX_NOTES_PER_RUN notes per run.\n// - Watch Inbox (Manual): Watch Inbox/ only (opt-in by design), the single newest note.\nconst MAX_ATTEMPTS = 3;\nconst watchInbox = $('Watch Inbox (Manual)').isExecuted;\nconst FOLDER = watchInbox ? 'Watch Inbox' : 'Index Inbox';\nconst MAX_NOTES_PER_RUN = watchInbox ? 1 : 5;\n\nconst files = $('List Inbox Notes').all();\nconst texts = $('Extract Note Text').all();\nconst states = {};\nfor (const row of $input.all()) {\n  if (row.json.notePath) states[row.json.notePath] = row.json;\n}\n\nconst candidates = [];\ntexts.forEach((item, i) => {\n  const src = files[item.pairedItem?.item ?? i] ?? files[i];\n  const bin = src?.binary?.data ?? {};\n  const fileName = bin.fileName ?? src?.json?.fileName ?? '';\n  const dir = (bin.directory ?? '').replace(/^\\/vault-mirror\\/?/, '');\n  const notePath = (dir ? dir + '/' : '') + fileName;\n  const noteText = item.json.noteText ?? '';\n  if (dir !== FOLDER || !fileName || noteText.includes('Researched:')) return;\n  const state = states[notePath];\n  if (state && (state.status === 'done' || (state.attempts ?? 0) >= MAX_ATTEMPTS)) return;\n  candidates.push({ notePath, noteText, fileName, attempts: state?.attempts ?? 0 });\n});\ncandidates.sort((a, b) => a.fileName.localeCompare(b.fileName));\nif (watchInbox) candidates.reverse();\n\nif ($runIndex >= MAX_NOTES_PER_RUN) {\n  return [{ json: { hasNote: false, reason: 'per-run cap reached', pending: candidates.length } }];\n}\nif (candidates.length === 0) {\n  return [{ json: { hasNote: false, reason: 'nothing to research', pending: 0 } }];\n}\nreturn [{ json: { hasNote: true, pending: candidates.length, ...candidates[0] } }];"
      }
    },
